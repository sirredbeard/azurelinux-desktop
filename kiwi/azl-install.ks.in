# Azure Linux Desktop - Anaconda Kickstart (Offline installer)
#
# Structure is a direct adaptation of Microsoft's own azl-install.ks.in
# (microsoft/azurelinux, base/images/vm-iso-installer/azl-install.ks.in,
# pinned commit noted in reference/azl-installer/README.md): same
# offline-repo install source, same LVM partitioning, same
# post-install.sh/post-bootloader.sh %post --nochroot blocks, generated
# the same way (kiwi/config.sh expands the packages placeholder below at
# ISO-build time - deliberately not spelled out literally in this
# sentence, since kiwi/config.sh's sed split matches on the FIRST
# occurrence of that exact string, and a second one here would silently
# move %packages to the top of the file and leave a literal, unresolved
# placeholder line orphaned further down - see
# findings/gh-actions-installer-iso-build.md for the real incident this
# comment is guarding against).
# Differences from upstream, all deliberate:
#   - no clearpart/autopart/part. Anaconda's interactive TUI handles disk
#     selection, partitioning scheme (standard/LVM), and optional LUKS.
#     That avoids silently wiping the wrong disk on multi-disk desktops.
#   - bare `reqpart` only: schedules platform-required partitions (ESP on
#     UEFI, biosboot on BIOS) so interactive Standard Partition + use all
#     free space still gets /boot/efi. Without it Anaconda can omit the
#     ESP and fail with STORAGE_MUST_NOT_BE_ON_ROOT. See
#     findings/installer-efi-separate-partition.md.
#   - a third %post --nochroot block staging this project's own
#     branding/tooling extras (Copilot, microsoft/edit, Flathub,
#     Plymouth theme, dock favorites, dark mode) into the installed
#     system - see kickstart/azurelinux-desktop-live.ks for the full
#     history behind each of these, not repeated here

# Installation source - local repo bundled on the ISO by kiwi/config.sh,
# exactly like upstream. Nothing here needs the network at install time.
repo --name=azl-offline --baseurl=file:///opt/azl-offline-repo/

lang en_US.UTF-8
keyboard us
timezone America/New_York --utc
selinux --enforcing
firewall --enabled --ssh
network --hostname=azurelinux-desktop
services --enabled=sshd,systemd-networkd,systemd-resolved,gdm,NetworkManager

bootloader
# Platform-required partitions only (UEFI ESP / BIOS biosboot). Do not add
# clearpart or autopart here — disk pick stays interactive.
reqpart

rootpw --lock

reboot --eject

@@PACKAGES@@

%post --nochroot --log=/mnt/sysroot/var/log/anaconda-post.log
cp /root/post-install.sh /mnt/sysroot/tmp/
chroot /mnt/sysroot bash /tmp/post-install.sh
rm -f /mnt/sysroot/tmp/post-install.sh
%end

%post --nochroot --log=/mnt/sysroot/var/log/anaconda-bootloader.log
/root/post-bootloader.sh
%end

# Azure Linux Desktop's own additions: stage branding/tooling extras
# from the offline areas kiwi/config.sh built (/opt/azl-offline-extras,
# /opt/azl-desktop-assets), which are only reachable from the install
# environment's own filesystem - hence --nochroot - not from inside
# %post's chroot into /mnt/sysroot.
%post --nochroot --log=/mnt/sysroot/var/log/azl-desktop-post-nochroot.log
set -x
# The Fedora 43 build container runs with umask 077; override so that
# mkdir -p creates directories at 755 and heredoc/cat writes land at 644.
umask 022
install -d -m 0755 /mnt/sysroot/root/thirdparty
install -d -m 0755 /mnt/sysroot/usr/share/pixmaps /mnt/sysroot/usr/share/applications /mnt/sysroot/usr/share/dbus-1/services
install -d -m 0755 /mnt/sysroot/usr/share/plymouth/themes/azurelinux

ASSETS=/opt/azl-desktop-assets
if [ -d "$ASSETS" ]; then
    install -m 0644 "$ASSETS/icons/edit.svg" /mnt/sysroot/usr/share/pixmaps/edit.svg
    install -m 0644 "$ASSETS/icons/powershell.png" /mnt/sysroot/usr/share/pixmaps/powershell.png
    install -m 0644 "$ASSETS/icons/dotnet.svg" /mnt/sysroot/usr/share/pixmaps/dotnet.svg
    install -m 0644 "$ASSETS/desktop/edit.desktop" /mnt/sysroot/usr/share/applications/edit.desktop
    install -m 0755 "$ASSETS/bin/azl-powershell-terminal" /mnt/sysroot/usr/local/bin/azl-powershell-terminal
    install -m 0755 "$ASSETS/bin/azl-dotnet-terminal" /mnt/sysroot/usr/local/bin/azl-dotnet-terminal
    install -m 0755 "$ASSETS/bin/azl-github-copilot" /mnt/sysroot/usr/local/bin/azl-github-copilot
    install -m 0644 "$ASSETS/desktop/org.azurelinux.PowerShell.desktop" /mnt/sysroot/usr/share/applications/org.azurelinux.PowerShell.desktop
    install -m 0644 "$ASSETS/dbus/org.azurelinux.PowerShell.service" /mnt/sysroot/usr/share/dbus-1/services/org.azurelinux.PowerShell.service
    install -m 0644 "$ASSETS/desktop/dotnet.desktop" /mnt/sysroot/usr/share/applications/dotnet.desktop
    install -m 0644 "$ASSETS/plymouth/azurelinux/azurelinux.plymouth" /mnt/sysroot/usr/share/plymouth/themes/azurelinux/azurelinux.plymouth
    install -m 0644 "$ASSETS/plymouth/azurelinux/azurelinux.script" /mnt/sysroot/usr/share/plymouth/themes/azurelinux/azurelinux.script
    install -m 0644 "$ASSETS/plymouth/azurelinux/dot.png" /mnt/sysroot/usr/share/plymouth/themes/azurelinux/dot.png
    install -m 0644 "$ASSETS/plymouth/azurelinux/dot-glow.png" /mnt/sysroot/usr/share/plymouth/themes/azurelinux/dot-glow.png
    install -m 0644 "$ASSETS/branding/AzureLinuxLogo.png" /mnt/sysroot/usr/share/plymouth/themes/azurelinux/azurelinuxlogo.png
    # 43x43 logo sized to match fedora-gdm-logo.png (149x43) height - used by
    # the GDM dconf override below to replace the Fedora login-screen badge.
    install -m 0644 "$ASSETS/branding/azurelinux-gdm-logo.png" /mnt/sysroot/usr/share/pixmaps/azurelinux-logo.png
    install -d -m 0755 /mnt/sysroot/usr/share/backgrounds/azurelinux
    install -m 0644 "$ASSETS/wallpapers/adwaita-l.jpg" /mnt/sysroot/usr/share/backgrounds/azurelinux/adwaita-l.jpg
    install -m 0644 "$ASSETS/wallpapers/adwaita-d.jpg" /mnt/sysroot/usr/share/backgrounds/azurelinux/adwaita-d.jpg
    # BT recover + PipeWire user preset + udev power rules must land on the
    # installed target. config.sh only stages them into the installer ISO
    # rootfs; without this block the chrooted enable below is a no-op.
    if [ -f "$ASSETS/bluetooth/azurelinux-desktop-bt-usb-reset" ]; then
        install -d -m 0755 /mnt/sysroot/usr/libexec \
            /mnt/sysroot/usr/lib/systemd/system \
            /mnt/sysroot/usr/lib/systemd/user-preset \
            /mnt/sysroot/etc/udev/rules.d
        install -m 0755 "$ASSETS/bluetooth/azurelinux-desktop-bt-usb-reset" \
            /mnt/sysroot/usr/libexec/azurelinux-desktop-bt-usb-reset
        install -m 0644 "$ASSETS/systemd/azurelinux-desktop-bt-recover.service" \
            /mnt/sysroot/usr/lib/systemd/system/azurelinux-desktop-bt-recover.service
        install -m 0644 "$ASSETS/systemd/azurelinux-desktop-bt-recover-late.service" \
            /mnt/sysroot/usr/lib/systemd/system/azurelinux-desktop-bt-recover-late.service
        install -m 0644 "$ASSETS/systemd/80-azurelinux-desktop-pipewire.preset" \
            /mnt/sysroot/usr/lib/systemd/user-preset/80-azurelinux-desktop-pipewire.preset
        if [ -f "$ASSETS/udev/80-azurelinux-desktop-bt-power.rules" ]; then
            install -m 0644 "$ASSETS/udev/80-azurelinux-desktop-bt-power.rules" \
                /mnt/sysroot/etc/udev/rules.d/80-azurelinux-desktop-bt-power.rules
        fi
    fi
    # Desktop journal caps + rotational-disk BFQ (NVMe stays none).
    if [ -f "$ASSETS/systemd/journald.conf.d/50-azurelinux-desktop.conf" ]; then
        install -d -m 0755 /mnt/sysroot/etc/systemd/journald.conf.d
        install -m 0644 "$ASSETS/systemd/journald.conf.d/50-azurelinux-desktop.conf" \
            /mnt/sysroot/etc/systemd/journald.conf.d/50-azurelinux-desktop.conf
    fi
    if [ -f "$ASSETS/udev/60-azurelinux-desktop-iosched.rules" ]; then
        install -d -m 0755 /mnt/sysroot/etc/udev/rules.d
        install -m 0644 "$ASSETS/udev/60-azurelinux-desktop-iosched.rules" \
            /mnt/sysroot/etc/udev/rules.d/60-azurelinux-desktop-iosched.rules
    fi
    # First-boot prepare: keep Plymouth up during SELinux relabel / disk grow.
    if [ -f "$ASSETS/bin/azl-first-boot-prepare" ]; then
        install -d -m 0755 /mnt/sysroot/usr/libexec/azurelinux-desktop \
            /mnt/sysroot/usr/lib/systemd/system/selinux-autorelabel.service.d
        install -m 0755 "$ASSETS/bin/azl-first-boot-prepare" \
            /mnt/sysroot/usr/libexec/azurelinux-desktop/azl-first-boot-prepare
        install -m 0644 "$ASSETS/systemd/selinux-autorelabel.service.d/10-azurelinux-desktop.conf" \
            /mnt/sysroot/usr/lib/systemd/system/selinux-autorelabel.service.d/10-azurelinux-desktop.conf
    fi
    # Intel iHD dri-nonfree -> dri link for Azure Linux libva.
    if [ -f "$ASSETS/bin/azl-link-intel-ihd" ]; then
        install -m 0755 "$ASSETS/bin/azl-link-intel-ihd" \
            /mnt/sysroot/usr/local/bin/azl-link-intel-ihd
    fi
    # RPM OpenPGP keys must land on the *installed* root. Chroot %post used
    # to look for /opt/azl-desktop-assets on the target (it is only on the
    # installer ISO), so metal installs missed Fedora/MS/GitHub/RPM Fusion
    # keys and dnf gpgcheck=1 failed. See findings/rpm-gpg-keys-on-target.md.
    if [ -d "$ASSETS/pki/rpm-gpg" ]; then
        install -d -m 0755 /mnt/sysroot/etc/pki/rpm-gpg
        for path in "$ASSETS/pki/rpm-gpg"/*; do
            [ -e "$path" ] || continue
            base="$(basename "$path")"
            case "$base" in
                *.md|README*) continue ;;
            esac
            if [ -L "$path" ]; then
                ln -sfn "$(readlink "$path")" "/mnt/sysroot/etc/pki/rpm-gpg/$base"
            elif [ -f "$path" ]; then
                install -m 0644 "$path" "/mnt/sysroot/etc/pki/rpm-gpg/$base"
            fi
        done
    fi
else
    echo "WARNING: $ASSETS not found in install environment - branding/launcher assets skipped" >&2
fi

EXTRAS=/opt/azl-offline-extras
test -d "$EXTRAS"
install -m 0644 "$EXTRAS"/github-copilot.rpm /mnt/sysroot/root/thirdparty/github-copilot.rpm
install -m 0644 "$EXTRAS"/copilot-linux-x64.tar.gz /mnt/sysroot/root/thirdparty/copilot-linux-x64.tar.gz
install -m 0644 "$EXTRAS"/edit.tar.gz /mnt/sysroot/root/thirdparty/edit.tar.gz
install -m 0644 "$EXTRAS"/dotnet-sdk-linux-x64.tar.gz /mnt/sysroot/root/thirdparty/dotnet-sdk-linux-x64.tar.gz
install -m 0755 "$EXTRAS"/install-dotnet-sdk-tarball.sh /mnt/sysroot/root/thirdparty/install-dotnet-sdk-tarball.sh
install -m 0755 "$EXTRAS"/configure-github-copilot-system-git.sh \
    /mnt/sysroot/root/thirdparty/configure-github-copilot-system-git.sh
if [ -s "$EXTRAS"/flathub.flatpakrepo ]; then
    install -m 0644 "$EXTRAS"/flathub.flatpakrepo /mnt/sysroot/root/thirdparty/flathub.flatpakrepo
fi
if [ -s "$EXTRAS"/thirdparty-versions.txt ]; then
    install -m 0644 "$EXTRAS"/thirdparty-versions.txt /mnt/sysroot/root/thirdparty/thirdparty-versions.txt
fi
# Microsoft Copilot GTK Flatpak OSTree + Flathub AppStream (pre-populated
# at image-build time so the target install stays offline). Copy the whole
# system Flatpak dir; remotes + Platform//50 + app + appstream land together
# (issue #6).
if [ -d "$EXTRAS/flatpak-system" ] && [ -f "$EXTRAS/flatpak-system/repo/config" ]; then
    mkdir -p /mnt/sysroot/var/lib/flatpak
    cp -a "$EXTRAS/flatpak-system"/. /mnt/sysroot/var/lib/flatpak/
    test -d /mnt/sysroot/var/lib/flatpak/app/com.github.sirredbeard.copilot-desktop-gtk
    test -e /mnt/sysroot/var/lib/flatpak/appstream/flathub/x86_64/active/appstream.xml \
        || test -e /mnt/sysroot/var/lib/flatpak/appstream/flathub/x86_64/active/appstream.xml.gz
    test -d /mnt/sysroot/var/lib/flatpak/appstream/flathub/x86_64/active/icons
else
    echo "error: staged Copilot Flatpak tree missing under $EXTRAS/flatpak-system" >&2
    exit 1
fi
# Chrooted %post cannot see installer /opt/azl-desktop-assets. Stage the
# full assets tree under the target /root/assets (same pattern as live).
rm -rf /mnt/sysroot/root/assets
if [ -d /opt/azl-desktop-assets ]; then
    cp -a /opt/azl-desktop-assets /mnt/sysroot/root/assets
elif [ -d /run/install/repo/azl-desktop-assets ]; then
    cp -a /run/install/repo/azl-desktop-assets /mnt/sysroot/root/assets
else
    echo "error: azl-desktop-assets not found for target stage" >&2
    exit 1
fi
test -f /mnt/sysroot/root/assets/pki/rpm-gpg/RPM-GPG-KEY-azurelinux-desktop
test -f /mnt/sysroot/root/assets/dconf/db/local.d/00-azl-desktop-defaults
# LIBVA env asset for azl-link-intel-ihd
if [ -f /mnt/sysroot/root/assets/environment.d/50-azurelinux-desktop-libva.conf ]; then
    install -d -m 0755 /mnt/sysroot/usr/share/azurelinux-desktop/environment.d
    install -m 0644 /mnt/sysroot/root/assets/environment.d/50-azurelinux-desktop-libva.conf \
        /mnt/sysroot/usr/share/azurelinux-desktop/environment.d/50-azurelinux-desktop-libva.conf
fi
%end

%post --log=/var/log/azl-desktop-post.log
set -x
# The Fedora 43 build container runs with umask 077; override so that
# mkdir -p creates directories at 755 and heredoc/cat writes land at 644.
umask 022

# Staged by %post --nochroot. Installer /opt is not visible in this chroot.
ASSETS=/root/assets
if [ ! -d "$ASSETS" ]; then
    echo "error: staged assets missing at $ASSETS" >&2
    exit 1
fi

# Persist the same runtime repo priority policy the live ISO ships (see
# kickstart/azurelinux-desktop-live.ks) - this machine is a real,
# persistent install, not a throwaway live session, so `dnf install
# <whatever>` next year needs the same "AZL first, Fedora 43 fills the
# gap" setup that was used to build it, not just the file:///opt/
# azl-offline-repo/ path that only existed for this one install.
# azurelinux-repos (in %packages above) already wrote the real AZL repo
# files. Fedora excludepkgs come from assets/yum.repos.d (same list as
# live kickstart repo lines) - no runtime awk rebuild.
# RPM OpenPGP keys: staged onto this root by --nochroot from installer
# ISO assets (not from /opt/azl-desktop-assets on the target - that path
# does not exist after install). Fail closed if any required key is missing.
install -d -m 0755 /etc/pki/rpm-gpg
for key in \
    RPM-GPG-KEY-azurelinux-4.0-primary \
    RPM-GPG-KEY-azurelinux-desktop \
    RPM-GPG-KEY-fedora-43-primary \
    RPM-GPG-KEY-microsoft \
    RPM-GPG-KEY-githubcli \
    RPM-GPG-KEY-shiftkey-desktop \
    RPM-GPG-KEY-rpmfusion-free-fedora-2020 \
    RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020
do
    if [ ! -e "/etc/pki/rpm-gpg/$key" ]; then
        echo "error: required RPM GPG key missing on target: $key" >&2
        echo "error: nochroot must copy assets/pki/rpm-gpg into /etc/pki/rpm-gpg" >&2
        ls -la /etc/pki/rpm-gpg >&2 || true
        exit 1
    fi
    rpm --import "/etc/pki/rpm-gpg/$key" 2>/dev/null || true
done

install -m 0644 "$ASSETS"/yum.repos.d/azl-desktop-fedora.repo \
    /etc/yum.repos.d/azl-desktop-fedora.repo

# The single azl-offline repo above only existed for this one install (it
# points at a directory that came from the boot media, not the installed
# system) - kiwi/config.sh built it by merging every real upstream repo
# (AZL, Fedora, ms-prod, vscode, edge-canary, gh-cli, github-desktop,
# rpmfusion-free/nonfree) into one offline blob. Persisting fedora43 above
# was already done; without also persisting the rest, PowerShell, .NET,
# VS Code Insiders, Edge Canary, GitHub CLI, GitHub Desktop, and the
# RPMFusion ffmpeg/gstreamer1-plugin-libav codec packages would be frozen at
# whatever version was current on the day this ISO was built, with no
# `dnf upgrade` path afterward. Persist their real upstream repos too.
install -m 0644 "$ASSETS"/yum.repos.d/azl-desktop-microsoft-github.repo \
    /etc/yum.repos.d/azl-desktop-microsoft-github.repo

install -m 0644 "$ASSETS"/yum.repos.d/azl-desktop-rpmfusion.repo \
    /etc/yum.repos.d/azl-desktop-rpmfusion.repo

# Project Pages kmod repo (signed sibling modules). Must land here in the
# chroot %post that already sees $ASSETS=/root/assets. kiwi/post-install.sh
# runs earlier via chroot and cannot see installer /opt/azl-desktop-assets,
# so a kmods install there always failed on metal. See
# findings/installer-kmods-repo-missing.md.
install -m 0644 "$ASSETS"/yum.repos.d/azl-desktop-kmods.repo \
    /etc/yum.repos.d/azl-desktop-kmods.repo
if [ ! -s /etc/yum.repos.d/azl-desktop-kmods.repo ]; then
    echo "error: azl-desktop-kmods.repo missing after asset stage" >&2
    exit 1
fi

# Stock azurelinux-repos writes [azurelinux-base] / [azurelinux-microsoft].
# Kickstart --excludepkgs does not persist into those files. Write
# excludepkgs so later dnf update keeps Fedora pinentry/grub/dnf5 and
# AZL owns NM plugins (findings/dnf-update-pinentry-nm-wwan.md).
python3 - <<'PY'
from pathlib import Path
import re

def set_exclude(path, section, pkgs):
    import sys
    p = Path(path)
    if not p.is_file():
        print(f"warning: missing repo file {path}", file=sys.stderr)
        return
    text = p.read_text()
    # Section body from ^[name] through the line before the next ^[ header.
    pat = re.compile(
        r"(^\[" + re.escape(section) + r"\][^\n]*\n.*?)(?=^\[|\Z)",
        re.M | re.S,
    )
    m = pat.search(text)
    if not m:
        print(f"warning: section [{section}] not in {path}", file=sys.stderr)
        return
    block = m.group(1)
    if re.search(r"^excludepkgs=", block, re.M):
        block = re.sub(
            r"^excludepkgs=.*$", "excludepkgs=" + pkgs, block, count=1, flags=re.M
        )
    else:
        block = block.rstrip("\n") + "\nexcludepkgs=" + pkgs + "\n"
    p.write_text(text[: m.start(1)] + block + text[m.end(1) :])

set_exclude("/etc/yum.repos.d/azurelinux.repo", "azurelinux-base", "hunspell-en,grub2,grub2-pc,grub2-pc-modules,grub2-efi-x64,grub2-efi-x64-modules,grub2-efi-x64-cdboot,grub2-tools,grub2-tools-extra,grub2-tools-minimal,grub2-common,shim,shim-x64,gsettings-desktop-schemas,dnf5,dnf5daemon-server,dnf5daemon-server-polkit,libdnf5,libdnf5-cli,libdnf5-plugin-actions,libdnf5-plugin-appstream,libdnf5-plugin-expired-pgp-keys,libdnf5-plugin-local,pinentry")
set_exclude("/etc/yum.repos.d/azurelinux.repo", "azurelinux-microsoft", "hunspell-en,grub2,grub2-pc,grub2-pc-modules,grub2-efi-x64,grub2-efi-x64-modules,grub2-efi-x64-cdboot,grub2-tools,grub2-tools-extra,grub2-tools-minimal,grub2-common,shim,shim-x64,gsettings-desktop-schemas,pinentry")
set_exclude("/etc/yum.repos.d/microsoft.repo", "azurelinux-microsoft", "hunspell-en,grub2,grub2-pc,grub2-pc-modules,grub2-efi-x64,grub2-efi-x64-modules,grub2-efi-x64-cdboot,grub2-tools,grub2-tools-extra,grub2-tools-minimal,grub2-common,shim,shim-x64,gsettings-desktop-schemas,pinentry")
PY

systemctl set-default graphical.target
systemctl enable gdm.service
# Hypervisor guest agents (same ship-all set as live). See
# findings/hypervisor-mouse-ps2-boxes.md.
systemctl enable spice-vdagentd.socket 2>/dev/null || true
systemctl enable spice-vdagentd.service 2>/dev/null || true
if [ -f /usr/lib/systemd/system/spice-vdagentd.socket ]; then
  mkdir -p /etc/systemd/system/sockets.target.wants
  ln -sfn /usr/lib/systemd/system/spice-vdagentd.socket \
    /etc/systemd/system/sockets.target.wants/spice-vdagentd.socket
fi
systemctl enable qemu-guest-agent.service 2>/dev/null || true
systemctl enable vmtoolsd.service 2>/dev/null || true
systemctl enable vboxservice.service 2>/dev/null || true
install -m 0644 "$ASSETS"/modules-load.d/azurelinux-desktop-virtio-input.conf \
  /etc/modules-load.d/azurelinux-desktop-virtio-input.conf
# Prevent gnome-initial-setup from running for users created by Anaconda's
# interactive TUI. Without this, any new user's first GDM session triggers
# the initial setup wizard, which resets system-db dconf keys (dark mode,
# wallpaper) to GNOME's own upstream defaults before the user ever touches
# Settings. InitialSetupEnable=False is GDM's own documented knob for
# exactly this scenario - it tells gnome-initial-setup not to launch at
# all, leaving the system-db defaults intact.
mkdir -p /etc/gdm
install -m 0644 "$ASSETS"/gdm/custom.conf /etc/gdm/custom.conf

# Passwordless sudo for wheel, same as the live ISO
# (kickstart/azurelinux-desktop-live.ks). Anaconda's TUI already puts
# the install-time admin user in wheel (anaconda-launcher.sh).
echo "%wheel ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/90-wheel-nopasswd
chmod 0440 /etc/sudoers.d/90-wheel-nopasswd
# rpm ghosts expect rpmdb.sqlite* 0644 root-owned. Restore world-read if a
# prior transaction left 0600 (blocks non-root rpm -q). Owner stays root.
if [ -d /usr/lib/sysimage/rpm ]; then
    chmod 0755 /usr/lib/sysimage/rpm 2>/dev/null || true
    chmod a+r /usr/lib/sysimage/rpm/rpmdb.sqlite \
        /usr/lib/sysimage/rpm/rpmdb.sqlite-shm \
        /usr/lib/sysimage/rpm/rpmdb.sqlite-wal 2>/dev/null || true
fi

if [ -x /usr/sbin/plymouth-set-default-theme ]; then
    plymouth-set-default-theme azurelinux || true
fi
mkdir -p /etc/dracut.conf.d
install -m 0644 "$ASSETS"/dracut.conf.d/no-multipath.conf \
    /etc/dracut.conf.d/no-multipath.conf
install -m 0644 "$ASSETS"/dracut.conf.d/early-kms.conf \
    /etc/dracut.conf.d/early-kms.conf

# Keep Plymouth animated for the full boot duration on the installed system.
mkdir -p /etc/systemd/system/plymouth-quit-wait.service.d
install -m 0644 "$ASSETS"/systemd/system/plymouth-quit-wait.service.d/wait-for-boot.conf \
    /etc/systemd/system/plymouth-quit-wait.service.d/wait-for-boot.conf

# Regenerate the initrd for every installed kernel now that the theme
# is selected and both dracut.conf.d overrides are in place. This step
# doesn't exist on the live ISO's kickstart because lorax runs its own
# fresh dracut pass against the whole install tree AFTER %post finishes
# (see kickstart/azurelinux-desktop-live.ks) - a real anaconda install
# has no such later pass, dracut only ran once already, at kernel
# %posttrans time, before any of this %post section ever touched
# plymouth or /etc/dracut.conf.d. Without this, the installed system
# would boot with the stock Fedora/AZL plymouth theme and the
# multipath/virtio_gpu tuning silently missing, even though every file
# above is in place.
dracut --regenerate-all --force

# System-wide dark mode, background, and dock favorites defaults - a persistent-install
# system has no livesys-scripts (that's live-media-only tooling, see
# kickstart/azurelinux-desktop-live.ks), so both defaults go through the
# standard, still user-overridable /etc/dconf/db/local.d/ mechanism
# instead of livesys-gnome's runtime favorite-apps patch.
mkdir -p /etc/dconf/db/local.d /etc/dconf/profile
install -m 0644 "$ASSETS"/dconf/db/local.d/00-azl-desktop-defaults \
    /etc/dconf/db/local.d/00-azl-desktop-defaults
install -m 0644 "$ASSETS"/dconf/profile/user \
    /etc/dconf/profile/user
dconf update
# Verify the compiled binary database was actually written - if dconf update
# failed (e.g., the dconf binary missing or the keyfile unparseable), GNOME
# silently ignores /etc/dconf/db/local.d/ at runtime and falls back to its
# own upstream defaults (solid blue background instead of our wallpaper).
test -s /etc/dconf/db/local

# GDM login-screen logo: fedora-logos ships a gschema override that sets
# org.gnome.login-screen logo='/usr/share/pixmaps/fedora-gdm-logo.png'.
# A dconf GDM profile + system-db keyfile overrides that at runtime without
# touching the schema file (which would drift on fedora-logos updates).
mkdir -p /etc/dconf/db/gdm.d
install -m 0644 "$ASSETS"/dconf/profile/gdm \
    /etc/dconf/profile/gdm
install -m 0644 "$ASSETS"/dconf/db/gdm.d/00-azl-login-screen \
    /etc/dconf/db/gdm.d/00-azl-login-screen
dconf update

# Override Fedora's gnome-software defaults: prefer Flathub, do not
# require fedora/updates repos that this image does not ship.
install -m 0644 "$ASSETS"/glib-2.0/schemas/org.gnome.software.gschema.override \
    /usr/share/glib-2.0/schemas/org.gnome.software.gschema.override
rm -f /etc/xdg/autostart/org.gnome.Software.desktop
grep -q '^DefaultDisabled=true' /usr/share/gnome-shell/search-providers/org.gnome.Software-search-provider.ini 2>/dev/null || \
  cat "$ASSETS"/gnome-shell/search-providers/org.gnome.Software-search-provider.ini.append >> \
  /usr/share/gnome-shell/search-providers/org.gnome.Software-search-provider.ini
glib-compile-schemas /usr/share/glib-2.0/schemas

test -s /root/thirdparty/github-copilot.rpm
test -s /root/thirdparty/copilot-linux-x64.tar.gz
test -s /root/thirdparty/edit.tar.gz
rpm -i /root/thirdparty/github-copilot.rpm
# Prefer distro git over bundled dugite git (libcurl-gnutls). See
# findings/github-copilot-bundled-git-libcurl.md.
test -x /usr/bin/git
test -x /root/thirdparty/configure-github-copilot-system-git.sh
/root/thirdparty/configure-github-copilot-system-git.sh /
tar -xzf /root/thirdparty/copilot-linux-x64.tar.gz -C /usr/local/bin copilot
chmod 0755 /usr/local/bin/copilot
test -x /usr/local/bin/copilot
tar -xOzf /root/thirdparty/edit.tar.gz edit > /usr/local/bin/edit
chmod 0755 /usr/local/bin/edit
test -x /usr/local/bin/edit
# .NET 11 SDK (Microsoft linux-x64 tarball; always latest 11.x)
test -s /root/thirdparty/dotnet-sdk-linux-x64.tar.gz
test -x /root/thirdparty/install-dotnet-sdk-tarball.sh
/root/thirdparty/install-dotnet-sdk-tarball.sh / /root/thirdparty/dotnet-sdk-linux-x64.tar.gz
test -x /usr/share/dotnet/dotnet
if [ -s /root/thirdparty/thirdparty-versions.txt ]; then
    install -m 0644 /root/thirdparty/thirdparty-versions.txt         /var/log/azl-desktop-thirdparty-versions.txt
fi
if [ -s /root/thirdparty/flathub.flatpakrepo ]; then
    flatpak remote-add --if-not-exists flathub /root/thirdparty/flathub.flatpakrepo 2>&1 || true
    # Prestaged tree already carries Flathub AppStream (issue #6). Best-effort
    # refresh when install-time network is up; first-boot unit is fallback.
    if [ ! -e /var/lib/flatpak/appstream/flathub/x86_64/active ]; then
        flatpak update --appstream 2>&1 || true
    fi
else
    echo "WARNING: flathub.flatpakrepo wasn't staged - flathub remote not added" >&2
fi
rm -rf /root/thirdparty

# Fallback when prestaged AppStream is missing (ConditionPathExists).
# Also drop empty sticky user xmlb silos after a late pull (issue #6).
install -m 0755 "$ASSETS"/libexec/azl-flatpak-appstream-refresh \
    /usr/libexec/azl-flatpak-appstream-refresh
chmod 0755 /usr/libexec/azl-flatpak-appstream-refresh
install -m 0644 "$ASSETS"/systemd/azl-flatpak-appstream.service \
    /usr/lib/systemd/system/azl-flatpak-appstream.service
systemctl enable azl-flatpak-appstream.service

# Bluetooth: never force-load btusb before platform rfkill (ThinkPad).
# USB device often enumerates before thinkpad_acpi unblocks radio; recover
# with a USB authorize cycle before bluetooth.service (see findings).
# See findings/bluetooth-hci-timeout-thinkpad.md.
install -m 0644 "$ASSETS"/modules-load.d/azurelinux-desktop-bluetooth.conf \
    /etc/modules-load.d/azurelinux-desktop-bluetooth.conf
install -m 0644 "$ASSETS"/modprobe.d/azurelinux-desktop-bluetooth.conf \
    /etc/modprobe.d/azurelinux-desktop-bluetooth.conf
# Assets staged by KIWI config.sh into the install tree when present.
if [ -x /usr/libexec/azurelinux-desktop-bt-usb-reset ]; then
    systemctl enable azurelinux-desktop-bt-recover.service 2>/dev/null || true
    systemctl enable azurelinux-desktop-bt-recover-late.service 2>/dev/null || true
fi
mkdir -p /etc/systemd/user/sockets.target.wants /etc/systemd/user/pipewire.service.wants
ln -sfn /usr/lib/systemd/user/pipewire.socket /etc/systemd/user/sockets.target.wants/pipewire.socket
ln -sfn /usr/lib/systemd/user/pipewire-pulse.socket /etc/systemd/user/sockets.target.wants/pipewire-pulse.socket
ln -sfn /usr/lib/systemd/user/wireplumber.service /etc/systemd/user/pipewire.service.wants/wireplumber.service
ln -sfn /usr/lib/systemd/user/wireplumber.service /etc/systemd/user/pipewire-session-manager.service

# Anaconda/localed can leave /etc/locale.conf mode 600. Fedora lang.sh
# (sourced on every interactive bash) runs sed against it, so pwsh->bash
# prints: /usr/bin/sed: can't read /etc/locale.conf: Permission denied
if [ -f /etc/locale.conf ]; then
    chmod 644 /etc/locale.conf || true
fi

install -m 0755 "$ASSETS"/profile.d/default-editor.sh \
    /etc/profile.d/default-editor.sh

if [ -x /usr/bin/pwsh ]; then
    if ! grep -q '^/usr/bin/pwsh$' /etc/shells; then
        echo /usr/bin/pwsh >> /etc/shells
    fi
    usermod --shell /usr/bin/pwsh root 2>/dev/null || true
fi

mkdir -p /etc/xdg
install -m 0644 "$ASSETS"/xdg/mimeapps.list \
    /etc/xdg/mimeapps.list

# GNOME Software uses DNF5 in this image. Let the locally authenticated,
# active administrator authorize its DNF5 and PackageKit actions.
mkdir -p /etc/polkit-1/rules.d
install -m 0644 "$ASSETS"/polkit-1/rules.d/49-azl-desktop-packagekit.rules \
    /etc/polkit-1/rules.d/49-azl-desktop-packagekit.rules
# Flatpak system updates for active local wheel (includes app-update).
install -m 0644 "$ASSETS"/polkit-1/rules.d/10-azurelinux-desktop-flatpak.rules \
    /etc/polkit-1/rules.d/10-azurelinux-desktop-flatpak.rules

# GNOME Keyring auto-unlock fix - identical mechanism to the live ISO,
# see kickstart/azurelinux-desktop-live.ks for the full root-cause
# writeup (autologin never provides a real password, so PAM never seeds
# or unlocks a login keyring on its own - this races gnome-keyring-
# daemon's own autostart entries and unlocks with a real empty string).
AUTOLOGIN_PAM="/etc/pam.d/gdm-autologin"
if [ -f "$AUTOLOGIN_PAM" ]; then
    if ! grep -qP '^auth\s+optional\s+pam_gnome_keyring' "$AUTOLOGIN_PAM"; then
        sed -i '/^auth.*pam_permit/i auth       optional    pam_gnome_keyring.so' "$AUTOLOGIN_PAM"
    fi
    if ! grep -q 'pam_gnome_keyring.*auto_start' "$AUTOLOGIN_PAM"; then
        sed -i '/^session.*postlogin/i session    optional    pam_gnome_keyring.so auto_start' "$AUTOLOGIN_PAM"
    fi
fi

install -m 0755 "$ASSETS"/libexec/azl-keyring-empty-unlock \
    /usr/libexec/azl-keyring-empty-unlock
chmod 0755 /usr/libexec/azl-keyring-empty-unlock

mkdir -p /etc/xdg/autostart
install -m 0644 "$ASSETS"/xdg/autostart/azl-keyring-empty-unlock.desktop \
    /etc/xdg/autostart/azl-keyring-empty-unlock.desktop

# Grow root on first boot (resized disk images / larger disks).
install -m 0755 "$ASSETS"/bin/azl-growroot /usr/local/sbin/azl-growroot
chmod 755 /usr/local/sbin/azl-growroot
install -m 0644 "$ASSETS"/systemd/azl-growroot.service \
    /usr/lib/systemd/system/azl-growroot.service
systemctl enable azl-growroot.service

# Intel iHD dri link + LIBVA_DRIVERS_PATH (Azure Linux libva).
if [ -x /usr/local/bin/azl-link-intel-ihd ]; then
    /usr/local/bin/azl-link-intel-ihd /
elif [ -x "$ASSETS"/bin/azl-link-intel-ihd ]; then
    install -m 0755 "$ASSETS"/bin/azl-link-intel-ihd /usr/local/bin/azl-link-intel-ihd
    /usr/local/bin/azl-link-intel-ihd /
fi
rpm -qa --qf '%{name}-%{version}-%{release}.%{arch}\n' | sort > /var/log/azl-desktop-install-package-list.txt

# Drop build-only asset tree staged by nochroot.
rm -rf /root/assets
%end
